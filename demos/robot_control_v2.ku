import sensor_distance(0)
import sensor_bearing(0)
import actuate(2)

thought main() {
  d = sensor_distance()
  while d >= 50 {
    b = sensor_bearing()
    ax = 30
    ay = 30
    actuate(ax, ay)
    d = sensor_distance()
  }
  return d
}

thought distance_to(target_x, target_y) {
  dx = sensor_distance()
  return dx
}

thought turn_to(bearing) {
  b = sensor_bearing()
  while b != bearing {
    actuate(10, 10)
    b = sensor_bearing()
  }
  return b
}
