// 配置解析与规则均在 Ku 中执行；Host 仅提供只读文本字节操作。
import source_len(1)
import source_byte(2)
import source_slice(3)

型 校验错误 {
  行号: 整数
  字段: 文本
  代码: 文本
  消息: 文本
}

思 裁剪(文本, 开始, 结束) {
  当 开始 < 结束 {
    字节 = source_byte(文本, 开始)
    若 字节 != 32 and 字节 != 9 and 字节 != 13 { 断 }
    开始 = 开始 + 1
  }
  当 结束 > 开始 {
    字节 = source_byte(文本, 结束 - 1)
    若 字节 != 32 and 字节 != 9 and 字节 != 13 { 断 }
    结束 = 结束 - 1
  }
  返 source_slice(文本, 开始, 结束 - 开始)
}

思 数值有效(文本, 上限) {
  大小 = source_len(文本)
  若 大小 == 0 { 返 假 }
  数值 = 0
  位置 = 0
  当 位置 < 大小 {
    数字 = source_byte(文本, 位置) - 48
    若 数字 < 0 or 数字 > 9 { 返 假 }
    若 数值 > 上限 / 10 { 返 假 }
    数值 = 数值 * 10 + 数字
    若 数值 > 上限 { 返 假 }
    位置 = 位置 + 1
  }
  返 数值 >= 1
}

思 记录错误(错误, 行号, 键, 代码, 消息) {
  push(错误, 校验错误 { 行号: 行号, 字段: 键, 代码: 代码, 消息: 消息 })
  返 空
}

// 只在公开返回处导出普通 Map，保留原生宿主的结果契约。
思 导出错误(错误) {
  返 {"line": 错误.行号, "key": 错误.字段, "code": 错误.代码, "message": 错误.消息}
}

思 处理行(文本, 开始, 结束, 行号, 已见, 错误) {
  行 = 裁剪(文本, 开始, 结束)
  大小 = source_len(行)
  若 大小 == 0 { 返 空 }
  若 source_byte(行, 0) == 35 { 返 空 }
  等号 = 0
  当 等号 < 大小 {
    若 source_byte(行, 等号) == 61 { 断 }
    等号 = 等号 + 1
  }
  若 等号 == 大小 {
    记录错误(错误, 行号, "", "syntax", "expected key=value")
    返 空
  }
  键 = 裁剪(行, 0, 等号)
  值 = 裁剪(行, 等号 + 1, 大小)
  若 键 != "name" and 键 != "port" and 键 != "workers" {
    记录错误(错误, 行号, 键, "unknown", "unknown key")
    返 空
  }
  若 已见[键] != 空 {
    记录错误(错误, 行号, 键, "duplicate", "duplicate key")
    返 空
  }
  已见[键] = 真
  若 键 == "name" {
    若 source_len(值) == 0 { 记录错误(错误, 行号, 键, "required", "name must not be empty") }
  } 否 若 键 == "port" {
    若 not 数值有效(值, 65535) { 记录错误(错误, 行号, 键, "range", "port must be a decimal integer in 1..65535") }
  } 否 {
    若 not 数值有效(值, 256) { 记录错误(错误, 行号, 键, "range", "workers must be a decimal integer in 1..256") }
  }
  返 空
}

思 校验(文本) {
  错误 = []
  已见 = {}
  大小 = source_len(文本)
  开始 = 0
  位置 = 0
  行号 = 1
  当 位置 < 大小 {
    若 source_byte(文本, 位置) == 10 {
      处理行(文本, 开始, 位置, 行号, 已见, 错误)
      开始 = 位置 + 1
      行号 = 行号 + 1
    }
    位置 = 位置 + 1
  }
  处理行(文本, 开始, 大小, 行号, 已见, 错误)
  遍 键 于 ["name", "port"] {
    若 已见[键] == 空 { 记录错误(错误, 0, 键, "required", "missing required key") }
  }
  公开错误 = []
  遍 项 于 错误 { push(公开错误, 导出错误(项)) }
  返 {"ok": len(错误) == 0, "errors": 公开错误}
}
