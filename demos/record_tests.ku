型 校验错误 {
  行号: 整数
  字段: 文本
  代码: 文本
  消息: 文本
}

思 端口错误(行号) {
  返 校验错误 {
    字段: "port",
    行号: 行号,
    消息: "port must be in 1..65535",
    代码: "range"
  }
}

// 显式导出普通 Map，供现有配置工具或 Host 边界使用。
思 导出错误(错误) {
  返 {"line": 错误.行号, "key": 错误.字段, "code": 错误.代码, "message": 错误.消息}
}

思 测试_具名构造() {
  错误 = 校验错误 { 行号: 2, 字段: "port", 代码: "range", 消息: "invalid port" }
  返 错误.行号 == 2 and 错误.字段 == "port" and 错误.代码 == "range"
}

思 测试_容器与导出() {
  错误列表 = [端口错误(2)]
  数据 = 导出错误(错误列表[0])
  返 错误列表[0].行号 == 2 and 数据["line"] == 2 and 数据["key"] == "port"
}
