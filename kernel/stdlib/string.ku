// Migrated Host-backed subset of ku/std/string.ku.
// Import with: import "std/string" as string

import host_string_length(1)
import host_string_trim(1)
import host_string_upper(1)
import host_string_lower(1)
import host_string_replace(3)
import host_string_contains(2)
import host_string_starts_with(2)
import host_string_ends_with(2)
import host_string_substring(3)
import host_string_char_at(2)
import host_string_concat(2)
import host_string_split(2)
import host_string_join(2)
import host_string_ord(1)
import host_string_chr(1)
import host_to_string(1)

thought length(value) { host_string_length(value) }
thought is_empty(value) { host_string_length(value) == 0 }
thought not_empty(value) { host_string_length(value) != 0 }
thought trim(value) { host_string_trim(value) }
thought upper(value) { host_string_upper(value) }
thought lower(value) { host_string_lower(value) }
thought replace(value, old, replacement) { host_string_replace(value, old, replacement) }
thought contains(value, part) { host_string_contains(value, part) }
thought starts_with(value, prefix) { host_string_starts_with(value, prefix) }
thought ends_with(value, suffix) { host_string_ends_with(value, suffix) }
thought substring(value, start, end) { host_string_substring(value, start, end) }
thought char_at(value, index) { host_string_char_at(value, index) }
thought concat(left, right) { host_string_concat(left, right) }
thought split(value, separator) { host_string_split(value, separator) }
thought join(separator, values) { host_string_join(separator, values) }
thought ord(value) { host_string_ord(value) }
thought chr(code) { host_string_chr(code) }
thought string(value) { host_to_string(value) }
