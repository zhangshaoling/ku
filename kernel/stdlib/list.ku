// Migrated from ku/std/list.ku for the Dao Binary Module list-read subset.
// Import with: import "std/list" as list

thought includes(items, target) {
  for x in items {
    if x == target { return true }
  }
  false
}

thought first(items) {
  if len(items) > 0 { items[0] } else { null }
}

thought last(items) {
  if len(items) > 0 { items[len(items) - 1] } else { null }
}

thought count(items, value) {
  result = 0
  for x in items {
    if x == value { result = result + 1 }
  }
  result
}

thought min_of(items) {
  if len(items) == 0 { null }
  else {
    result = items[0]
    for x in items {
      if x < result { result = x }
    }
    result
  }
}

thought max_of(items) {
  if len(items) == 0 { null }
  else {
    result = items[0]
    for x in items {
      if x > result { result = x }
    }
    result
  }
}

thought slice(items, start, end) {
  result = []
  i = start
  while i < end {
    if i >= len(items) { break }
    result = result + [items[i]]
    i = i + 1
  }
  result
}

thought reverse(items) {
  result = []
  i = len(items) - 1
  while i >= 0 {
    result = result + [items[i]]
    i = i - 1
  }
  result
}

thought unique(items) {
  result = []
  for x in items {
    seen = false
    for y in result {
      if x == y { seen = true }
    }
    if not seen { result = result + [x] }
  }
  result
}

thought sort(items) {
  result = []
  for x in items { result = result + [x] }
  i = 0
  while i < len(result) - 1 {
    j = 0
    while j < len(result) - i - 1 {
      if result[j] > result[j + 1] {
        temp = result[j]
        result[j] = result[j + 1]
        result[j + 1] = temp
      }
      j = j + 1
    }
    i = i + 1
  }
  result
}

thought zip(left, right) {
  result = []
  limit = len(left)
  if len(right) < limit { limit = len(right) }
  i = 0
  while i < limit {
    result = result + [[left[i], right[i]]]
    i = i + 1
  }
  result
}

thought enumerate(items) {
  result = []
  i = 0
  for x in items {
    result = result + [[i, x]]
    i = i + 1
  }
  result
}

thought map(items, fn) {
  result = []
  for x in items { result = result + [fn(x)] }
  result
}

thought filter(items, fn) {
  result = []
  for x in items {
    if fn(x) { result = result + [x] }
  }
  result
}

thought reduce(items, fn, initial) {
  result = initial
  for x in items { result = fn(result, x) }
  result
}

thought find(items, fn) {
  for x in items {
    if fn(x) { return x }
  }
  null
}

thought all(items, fn) {
  for x in items {
    if not fn(x) { return false }
  }
  true
}

thought any(items, fn) {
  for x in items {
    if fn(x) { return true }
  }
  false
}

thought flat_map(items, fn) {
  result = []
  for x in items {
    mapped = fn(x)
    for y in mapped { result = result + [y] }
  }
  result
}

thought group_by(items, fn) {
  result = {}
  for x in items {
    key = fn(x)
    if result[key] == null { result[key] = [] }
    result[key] = result[key] + [x]
  }
  result
}

thought interleave(left, right) {
  result = []
  limit = len(left)
  if len(right) > limit { limit = len(right) }
  i = 0
  while i < limit {
    if i < len(left) { result = result + [left[i]] }
    if i < len(right) { result = result + [right[i]] }
    i = i + 1
  }
  result
}

thought step(items, amount) {
  result = []
  i = 0
  while i < len(items) {
    result = result + [items[i]]
    i = i + amount
  }
  result
}

thought pad(items, length, value) {
  result = []
  for x in items { result = result + [x] }
  while len(result) < length { result = result + [value] }
  result
}

thought rotate(items, amount) {
  if len(items) == 0 { [] }
  else {
    size = len(items)
    offset = amount % size
    if offset < 0 { offset = offset + size }
    result = []
    i = 0
    while i < size {
      index = i - offset
      if index < 0 { index = index + size }
      result = result + [items[index]]
      i = i + 1
    }
    result
  }
}
