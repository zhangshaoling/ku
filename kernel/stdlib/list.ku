// Migrated from ku/std/list.ku for the Dao Binary Module list-read subset.
// Import with: import "std/list" as list

thought includes(items, target) {
  for x in items {
    if x == target { return true }
  }
  false
}

thought first(items) {
  if len(items) > 0 { items[0] } else { null }
}

thought last(items) {
  if len(items) > 0 { items[len(items) - 1] } else { null }
}

thought count(items, value) {
  result = 0
  for x in items {
    if x == value { result = result + 1 }
  }
  result
}

thought min_of(items) {
  if len(items) == 0 { null }
  else {
    result = items[0]
    for x in items {
      if x < result { result = x }
    }
    result
  }
}

thought max_of(items) {
  if len(items) == 0 { null }
  else {
    result = items[0]
    for x in items {
      if x > result { result = x }
    }
    result
  }
}

thought slice(items, start, end) {
  result = []
  i = start
  while i < end {
    if i >= len(items) { break }
    result = result + [items[i]]
    i = i + 1
  }
  result
}

thought reverse(items) {
  result = []
  i = len(items) - 1
  while i >= 0 {
    result = result + [items[i]]
    i = i - 1
  }
  result
}

thought unique(items) {
  result = []
  for x in items {
    seen = false
    for y in result {
      if x == y { seen = true }
    }
    if not seen { result = result + [x] }
  }
  result
}

thought sort(items) {
  result = []
  for x in items { result = result + [x] }
  i = 0
  while i < len(result) - 1 {
    j = 0
    while j < len(result) - i - 1 {
      if result[j] > result[j + 1] {
        temp = result[j]
        result[j] = result[j + 1]
        result[j + 1] = temp
      }
      j = j + 1
    }
    i = i + 1
  }
  result
}

thought zip(left, right) {
  result = []
  limit = len(left)
  if len(right) < limit { limit = len(right) }
  i = 0
  while i < limit {
    result = result + [[left[i], right[i]]]
    i = i + 1
  }
  result
}

thought enumerate(items) {
  result = []
  i = 0
  for x in items {
    result = result + [[i, x]]
    i = i + 1
  }
  result
}
