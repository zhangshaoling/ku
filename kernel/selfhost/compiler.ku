import source_len(1)
import source_byte(2)
import source_hash(3)
import builder_new(0)
import builder_begin(3)
import builder_emit(6)
import builder_position(1)
import builder_patch(3)
import builder_patch_marked(5)
import builder_finish(2)
import builder_encode(1)

thought pack(index, next_reg, result_reg) {
  index * 1000000 + next_reg * 1000 + result_reg
}

thought packed_index(value) { value / 1000000 }
thought packed_next(value) { value / 1000 % 1000 }
thought packed_result(value) { value % 1000 }

thought skip_space(source, index, size) {
  while index < size {
    byte = source_byte(source, index)
    if byte != 32 and byte != 10 and byte != 13 and byte != 9 { break }
    index = index + 1
  }
  index
}

thought source_at(source, index, size) {
  if index < 0 or index >= size { return 0 }
  source_byte(source, index)
}

thought is_space(byte) {
  byte == 32 or byte == 10 or byte == 13 or byte == 9
}

thought is_word_end(byte) {
  is_space(byte) or byte == 59 or byte == 125
}

thought parse_number(source, index, size, handle, next_reg) {
  index = skip_space(source, index, size)
  value = 0
  while index < size {
    byte = source_byte(source, index)
    if byte < 48 or byte > 57 { break }
    value = value * 10 + byte - 48
    index = index + 1
  }
  result_reg = next_reg
  builder_emit(handle, 1, result_reg, 0, 0, value)
  pack(index, next_reg + 1, result_reg)
}

thought lookup_slot(names, name_hash) {
  i = len(names) - 1
  while i >= 0 {
    if names[i] == name_hash { return i + 1 }
    i = i - 1
  }
  0
}

thought lookup_reg(names, regs, name_hash) {
  slot = lookup_slot(names, name_hash)
  if slot == 0 { return 0 }
  regs[slot - 1]
}

thought function_index(source, size, target_hash) {
  index = 0
  ordinal = 0
  while index < size {
    index = skip_space(source, index, size)
    while index < size {
      if source_byte(source, index) == 32 { break }
      index = index + 1
    }
    index = skip_space(source, index, size)
    name_start = index
    while index < size {
      if source_byte(source, index) == 40 { break }
      index = index + 1
    }
    if source_hash(source, name_start, index - name_start) == target_hash { return ordinal }
    ordinal = ordinal + 1
    while index < size {
      if source_byte(source, index) == 125 { index = index + 1 break }
      index = index + 1
    }
  }
  0
}

thought parse_primary(source, index, size, handle, next_reg, names, regs) {
  index = skip_space(source, index, size)
  byte = source_byte(source, index)
  if byte == 45 {
    parsed = parse_primary(source, index + 1, size, handle, next_reg, names, regs)
    index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    zero_reg = next_reg
    builder_emit(handle, 1, zero_reg, 0, 0, 0)
    next_reg = next_reg + 1
    result_reg = next_reg
    builder_emit(handle, 4, result_reg, zero_reg, value_reg, 0)
    return pack(index, next_reg + 1, result_reg)
  }
  if byte == 40 {
    parsed = parse_expression(source, index + 1, size, handle, next_reg, names, regs)
    index = skip_space(source, packed_index(parsed), size)
    if source_byte(source, index) == 41 { index = index + 1 }
    return pack(index, packed_next(parsed), packed_result(parsed))
  }
  if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 {
    name_start = index
    while index < size {
      byte = source_byte(source, index)
      if not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95) { break }
      index = index + 1
    }
    name_hash = source_hash(source, name_start, index - name_start)
    after_name = skip_space(source, index, size)
    if source_byte(source, after_name) == 40 {
      index = skip_space(source, after_name + 1, size)
      arguments = []
      while source_byte(source, index) != 41 {
        parsed = parse_expression(source, index, size, handle, next_reg, names, regs)
        argument_reg = packed_result(parsed)
        next_reg = packed_next(parsed)
        saved_reg = next_reg
        builder_emit(handle, 2, saved_reg, argument_reg, 0, 0)
        next_reg = next_reg + 1
        arguments = arguments + [saved_reg]
        index = skip_space(source, packed_index(parsed), size)
        if source_byte(source, index) == 44 { index = skip_space(source, index + 1, size) continue }
        break
      }
      if source_byte(source, index) == 41 { index = index + 1 }
      argument_reg = next_reg
      argument_count = 0
      while argument_count < len(arguments) {
        builder_emit(handle, 2, next_reg, arguments[argument_count], 0, 0)
        next_reg = next_reg + 1
        argument_count = argument_count + 1
      }
      result_reg = next_reg
      builder_emit(handle, 14, result_reg, argument_reg, argument_count, function_index(source, size, name_hash))
      return pack(index, next_reg + 1, result_reg)
    }
    return pack(index, next_reg, lookup_reg(names, regs, name_hash))
  }
  parse_number(source, index, size, handle, next_reg)
}

thought parse_multiplicative(source, index, size, handle, next_reg, names, regs) {
  parsed = parse_primary(source, index, size, handle, next_reg, names, regs)
  index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while index < size {
    index = skip_space(source, index, size)
    opcode = 0
    byte = source_byte(source, index)
    if byte == 42 { opcode = 5 }
    if byte == 47 { opcode = 6 }
    if byte == 37 { opcode = 18 }
    if opcode == 0 { break }
    parsed = parse_primary(source, index + 1, size, handle, next_reg, names, regs)
    index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(index, next_reg, result_reg)
}

thought parse_additive(source, index, size, handle, next_reg, names, regs) {
  parsed = parse_multiplicative(source, index, size, handle, next_reg, names, regs)
  index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while index < size {
    index = skip_space(source, index, size)
    opcode = 0
    byte = source_byte(source, index)
    if byte == 43 { opcode = 3 }
    if byte == 45 { opcode = 4 }
    if opcode == 0 { break }
    parsed = parse_multiplicative(source, index + 1, size, handle, next_reg, names, regs)
    index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(index, next_reg, result_reg)
}

thought parse_expression(source, index, size, handle, next_reg, names, regs) {
  parsed = parse_additive(source, index, size, handle, next_reg, names, regs)
  index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  index = skip_space(source, index, size)
  opcode = 0
  byte = source_byte(source, index)
  next_byte = 0
  if index + 1 < size { next_byte = source_byte(source, index + 1) }
  if byte == 61 and next_byte == 61 { opcode = 19 index = index + 2 }
  if byte == 33 and next_byte == 61 { opcode = 20 index = index + 2 }
  if byte == 60 {
    opcode = 21
    index = index + 1
    if source_byte(source, index) == 61 { opcode = 22 index = index + 1 }
  }
  if byte == 62 {
    opcode = 23
    index = index + 1
    if source_byte(source, index) == 61 { opcode = 24 index = index + 1 }
  }
  if opcode == 0 { return pack(index, next_reg, result_reg) }
  parsed = parse_additive(source, index, size, handle, next_reg, names, regs)
  index = packed_index(parsed)
  next_reg = packed_next(parsed)
  value_reg = packed_result(parsed)
  combined_reg = next_reg
  builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
  pack(index, next_reg + 1, combined_reg)
}

thought parse_body(source, index, size, handle, next_reg, names, regs, loop_depth) {
  result_reg = 0
  while index < size {
    index = skip_space(source, index, size)
    if source_byte(source, index) == 125 { break }
    if source_at(source, index, size) == 98 and source_at(source, index + 1, size) == 114 and source_at(source, index + 2, size) == 101 and source_at(source, index + 3, size) == 97 and source_at(source, index + 4, size) == 107 and is_word_end(source_at(source, index + 5, size)) {
      if loop_depth > 0 { builder_emit(handle, 13, 0, 0, 0, -1) }
      index = index + 5
      if source_at(source, index, size) == 59 { index = index + 1 }
      continue
    }
    if source_at(source, index, size) == 99 and source_at(source, index + 1, size) == 111 and source_at(source, index + 2, size) == 110 and source_at(source, index + 3, size) == 116 and source_at(source, index + 4, size) == 105 and source_at(source, index + 5, size) == 110 and source_at(source, index + 6, size) == 117 and source_at(source, index + 7, size) == 101 and is_word_end(source_at(source, index + 8, size)) {
      if loop_depth > 0 { builder_emit(handle, 13, 0, 0, 0, -2) }
      index = index + 8
      if source_at(source, index, size) == 59 { index = index + 1 }
      continue
    }
    if source_at(source, index, size) == 105 and source_at(source, index + 1, size) == 102 and is_space(source_at(source, index + 2, size)) {
      parsed = parse_expression(source, index + 2, size, handle, next_reg, names, regs)
      index = skip_space(source, packed_index(parsed), size)
      next_reg = packed_next(parsed)
      condition_reg = packed_result(parsed)
      while index < size {
        if source_at(source, index, size) == 123 { index = index + 1 break }
        index = index + 1
      }
      negative_branch = builder_position(handle)
      builder_emit(handle, 10, 0, condition_reg, 0, 0)
      zero_branch = builder_position(handle)
      builder_emit(handle, 11, 0, condition_reg, 0, 0)
      parsed = parse_body(source, index, size, handle, next_reg, names, regs, loop_depth)
      index = packed_index(parsed)
      next_reg = packed_next(parsed)
      if source_at(source, index, size) == 125 { index = index + 1 }
      index = skip_space(source, index, size)
      if source_at(source, index, size) == 101 and source_at(source, index + 1, size) == 108 and source_at(source, index + 2, size) == 115 and source_at(source, index + 3, size) == 101 and (is_space(source_at(source, index + 4, size)) or source_at(source, index + 4, size) == 123) {
        end_branch = builder_position(handle)
        builder_emit(handle, 13, 0, 0, 0, 0)
        alternate_start = builder_position(handle)
        builder_patch(handle, negative_branch, alternate_start)
        builder_patch(handle, zero_branch, alternate_start)
        index = index + 4
        while index < size {
          if source_at(source, index, size) == 123 { index = index + 1 break }
          index = index + 1
        }
        parsed = parse_body(source, index, size, handle, next_reg, names, regs, loop_depth)
        index = packed_index(parsed)
        next_reg = packed_next(parsed)
        if source_at(source, index, size) == 125 { index = index + 1 }
        target = builder_position(handle)
        builder_patch(handle, end_branch, target)
        continue
      }
      target = builder_position(handle)
      builder_patch(handle, negative_branch, target)
      builder_patch(handle, zero_branch, target)
      continue
    }
    if source_at(source, index, size) == 114 and source_at(source, index + 1, size) == 101 and source_at(source, index + 2, size) == 116 and source_at(source, index + 3, size) == 117 and source_at(source, index + 4, size) == 114 and source_at(source, index + 5, size) == 110 and is_space(source_at(source, index + 6, size)) {
      parsed = parse_expression(source, index + 6, size, handle, next_reg, names, regs)
      index = packed_index(parsed)
      next_reg = packed_next(parsed)
      result_reg = packed_result(parsed)
      builder_emit(handle, 15, 0, result_reg, 0, 0)
      if source_at(source, index, size) == 59 { index = index + 1 continue }
      break
    }
    if source_at(source, index, size) == 119 and source_at(source, index + 1, size) == 104 and source_at(source, index + 2, size) == 105 and source_at(source, index + 3, size) == 108 and source_at(source, index + 4, size) == 101 and is_space(source_at(source, index + 5, size)) {
      loop_start = builder_position(handle)
      parsed = parse_expression(source, index + 5, size, handle, next_reg, names, regs)
      index = skip_space(source, packed_index(parsed), size)
      next_reg = packed_next(parsed)
      condition_reg = packed_result(parsed)
      while index < size {
        if source_at(source, index, size) == 123 { index = index + 1 break }
        index = index + 1
      }
      negative_branch = builder_position(handle)
      builder_emit(handle, 10, 0, condition_reg, 0, 0)
      zero_branch = builder_position(handle)
      builder_emit(handle, 11, 0, condition_reg, 0, 0)
      body_start = builder_position(handle)
      parsed = parse_body(source, index, size, handle, next_reg, names, regs, loop_depth + 1)
      index = packed_index(parsed)
      next_reg = packed_next(parsed)
      body_end = builder_position(handle)
      builder_emit(handle, 13, 0, 0, 0, loop_start)
      target = builder_position(handle)
      builder_patch(handle, negative_branch, target)
      builder_patch(handle, zero_branch, target)
      builder_patch_marked(handle, body_start, body_end, -1, target)
      builder_patch_marked(handle, body_start, body_end, -2, loop_start)
      if source_at(source, index, size) == 125 { index = index + 1 }
      continue
    }
    name_start = index
    probe = index
    while probe < size {
      byte = source_byte(source, probe)
      if not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95) { break }
      probe = probe + 1
    }
    after_name = skip_space(source, probe, size)
    next_byte = 0
    if after_name + 1 < size { next_byte = source_byte(source, after_name + 1) }
    if probe > name_start and source_byte(source, after_name) == 61 and next_byte != 61 {
      parsed = parse_expression(source, after_name + 1, size, handle, next_reg, names, regs)
      index = packed_index(parsed)
      next_reg = packed_next(parsed)
      result_reg = packed_result(parsed)
      name_hash = source_hash(source, name_start, probe - name_start)
      slot = lookup_slot(names, name_hash)
      if slot == 0 {
        names = names + [name_hash]
        regs = regs + [result_reg]
      } else {
        result_reg = regs[slot - 1]
        builder_emit(handle, 2, result_reg, packed_result(parsed), 0, 0)
      }
      if source_byte(source, index) == 59 { index = index + 1 continue }
      break
    }
    parsed = parse_expression(source, index, size, handle, next_reg, names, regs)
    index = packed_index(parsed)
    next_reg = packed_next(parsed)
    result_reg = packed_result(parsed)
    if source_byte(source, index) == 59 { index = index + 1 continue }
    break
  }
  pack(index, next_reg, result_reg)
}

thought compile(source) {
  handle = builder_new()
  size = source_len(source)
  index = 0
  while index < size {
    index = skip_space(source, index, size)
    if index >= size { break }
    while index < size {
      if source_byte(source, index) == 32 { break }
      index = index + 1
    }
    index = skip_space(source, index, size)
    name_start = index
    while index < size {
      if source_byte(source, index) == 40 { break }
      index = index + 1
    }
    name_length = index - name_start
    export_symbol = source_hash(source, name_start, name_length)
    names = []
    regs = []
    param_count = 0
    index = index + 1
    while index < size {
      index = skip_space(source, index, size)
      if source_byte(source, index) == 41 { index = index + 1 break }
      param_start = index
      while index < size {
        byte = source_byte(source, index)
        if byte == 44 or byte == 41 { break }
        index = index + 1
      }
      param_end = index
      while param_end > param_start {
        if source_byte(source, param_end - 1) != 32 { break }
        param_end = param_end - 1
      }
      names = names + [source_hash(source, param_start, param_end - param_start)]
      regs = regs + [param_count]
      param_count = param_count + 1
      if source_byte(source, index) == 44 { index = index + 1 }
      if source_byte(source, index) == 41 { index = index + 1 break }
    }
    builder_begin(handle, param_count, 64)
    while index < size {
      if source_byte(source, index) == 123 { index = index + 1 break }
      index = index + 1
    }
    parsed = parse_body(source, index, size, handle, param_count, names, regs, 0)
    result_reg = packed_result(parsed)
    builder_emit(handle, 15, 0, result_reg, 0, 0)
    builder_finish(handle, export_symbol)
    index = packed_index(parsed)
    while index < size {
      if source_byte(source, index) == 125 { index = index + 1 break }
      index = index + 1
    }
  }
  builder_encode(handle)
}
