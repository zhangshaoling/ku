import source_len(1)
import source_byte(2)
import source_slice(3)
import source_hash(3)
import module_source(1)
import string_new(0)
import string_append(2)
import string_finish(1)
import builder_new(0)
import builder_begin(3)
import builder_emit_raw(6)
import builder_add_string(2)
import builder_import(3)
import builder_position(1)
import builder_patch(3)
import builder_patch_marked(5)
import builder_finish(3)
import builder_encode(1)
import builder_identity(5)
import builder_module_import(7)

thought pack(index, next_reg, result_reg) {
  index * 10000000000 + next_reg * 100000 + result_reg
}

thought packed_index(value) { value / 10000000000 }
thought packed_next(value) { value / 100000 % 100000 }
thought packed_result(value) { value % 100000 }

thought builder_emit(handle, opcode, dst, a, b, immediate) {
  if dst < 0 or dst >= 4096 or a < 0 or a >= 4096 or b < 0 or b >= 4096 {
    throw "register limit exceeded"
  }
  builder_emit_raw(handle, opcode, dst, a, b, immediate)
}

thought source_at(source, index, size) {
  if index < 0 or index >= size { return 0 }
  source_byte(source, index)
}

thought token_type(token) { token / 1000000000000 }
thought token_start(token) { token / 1000000 % 1000000 }
thought token_length(token) { token % 1000000 }
thought make_token(type, start, length) {
  type * 1000000000000 + start * 1000000 + length
}

thought append_decimal(handle, value) {
  if value == 0 { string_append(handle, 48) return 0 }
  divisor = 1
  while value / divisor >= 10 { divisor = divisor * 10 }
  while divisor > 0 {
    string_append(handle, value / divisor % 10 + 48)
    divisor = divisor / 10
  }
  0
}

thought fail_at(message, offset) {
  handle = string_new()
  index = 0
  length = source_len(message)
  while index < length {
    string_append(handle, source_byte(message, index))
    index = index + 1
  }
  string_append(handle, 32)
  string_append(handle, 97)
  string_append(handle, 116)
  string_append(handle, 32)
  string_append(handle, 111)
  string_append(handle, 102)
  string_append(handle, 102)
  string_append(handle, 115)
  string_append(handle, 101)
  string_append(handle, 116)
  string_append(handle, 32)
  append_decimal(handle, offset)
  throw string_finish(handle)
}

thought fail_token(message, tokens, token_index) {
  fail_at(message, token_start(tokens[token_index]))
}

thought token_integer(source, token) {
  value = 0
  pos = token_start(token)
  end = pos + token_length(token)
  while pos < end {
    value = value * 10 + source_byte(source, pos) - 48
    pos = pos + 1
  }
  value
}

thought tokenize(source, size) {
  if size >= 1000000 { fail_at("source is too large", 0) }
  index = 0
  tokens = []
  while index < size {
    byte = source_byte(source, index)
    if byte == 10 {
      tokens = tokens + [make_token(11, index, 1)]
      index = index + 1
      continue
    }
    if byte == 32 or byte == 13 or byte == 9 { index = index + 1 continue }
    if byte >= 48 and byte <= 57 {
      start = index
      while index < size {
        b = source_byte(source, index)
        if b < 48 or b > 57 { break }
        index = index + 1
      }
      tokens = tokens + [make_token(1, start, index - start)]
      continue
    }
    if byte == 34 {
      start = index
      index = index + 1
      while index < size {
        b = source_at(source, index, size)
        if b == 92 { index = index + 2 continue }
        if b == 34 { break }
        index = index + 1
      }
      if index >= size { fail_at("unterminated string literal", start) }
      index = index + 1
      tokens = tokens + [make_token(2, start, index - start)]
      continue
    }
    if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 or byte >= 128 {
      start = index
      while index < size {
        b = source_byte(source, index)
        if not ((b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 95 or b >= 128) { break }
        index = index + 1
      }
      tokens = tokens + [make_token(3, start, index - start)]
      continue
    }
    start = index
    next_byte = 0
    if index + 1 < size { next_byte = source_byte(source, index + 1) }
    if byte == 40 { index = index + 1 tokens = tokens + [make_token(4, start, 1)] continue }
    if byte == 41 { index = index + 1 tokens = tokens + [make_token(5, start, 1)] continue }
    if byte == 123 { index = index + 1 tokens = tokens + [make_token(6, start, 1)] continue }
    if byte == 125 { index = index + 1 tokens = tokens + [make_token(7, start, 1)] continue }
    if byte == 91 { index = index + 1 tokens = tokens + [make_token(8, start, 1)] continue }
    if byte == 93 { index = index + 1 tokens = tokens + [make_token(9, start, 1)] continue }
    if byte == 44 { index = index + 1 tokens = tokens + [make_token(10, start, 1)] continue }
    if byte == 59 {
      if next_byte == 59 {
        while index < size and source_byte(source, index) != 10 { index = index + 1 }
        continue
      }
      index = index + 1
      tokens = tokens + [make_token(11, start, 1)]
      continue
    }
    if byte == 58 { index = index + 1 tokens = tokens + [make_token(12, start, 1)] continue }
    if byte == 43 { index = index + 1 tokens = tokens + [make_token(13, start, 1)] continue }
    if byte == 45 { index = index + 1 tokens = tokens + [make_token(14, start, 1)] continue }
    if byte == 42 { index = index + 1 tokens = tokens + [make_token(15, start, 1)] continue }
    if byte == 47 {
      if next_byte == 47 {
        while index < size and source_byte(source, index) != 10 { index = index + 1 }
        continue
      }
      index = index + 1 tokens = tokens + [make_token(16, start, 1)] continue
    }
    if byte == 37 { index = index + 1 tokens = tokens + [make_token(17, start, 1)] continue }
    if byte == 61 {
      if next_byte == 61 { index = index + 2 tokens = tokens + [make_token(19, start, 2)] continue }
      index = index + 1 tokens = tokens + [make_token(18, start, 1)] continue
    }
    if byte == 33 {
      if next_byte == 61 { index = index + 2 tokens = tokens + [make_token(20, start, 2)] continue }
      index = index + 1 tokens = tokens + [make_token(25, start, 1)] continue
    }
    if byte == 60 {
      if next_byte == 61 { index = index + 2 tokens = tokens + [make_token(22, start, 2)] continue }
      index = index + 1 tokens = tokens + [make_token(21, start, 1)] continue
    }
    if byte == 62 {
      if next_byte == 61 { index = index + 2 tokens = tokens + [make_token(24, start, 2)] continue }
      index = index + 1 tokens = tokens + [make_token(23, start, 1)] continue
    }
    fail_at("unexpected character", index)
  }
  tokens = tokens + [make_token(26, index, 0)]
  tokens
}

thought is_kw(source, token, n, c0, c1, c2, c3, c4, c5, c6, c7) {
  if token_length(token) != n { return 1 != 1 }
  s = token_start(token)
  if n > 0 { if source_byte(source, s) != c0 { return 1 != 1 } }
  if n > 1 { if source_byte(source, s + 1) != c1 { return 1 != 1 } }
  if n > 2 { if source_byte(source, s + 2) != c2 { return 1 != 1 } }
  if n > 3 { if source_byte(source, s + 3) != c3 { return 1 != 1 } }
  if n > 4 { if source_byte(source, s + 4) != c4 { return 1 != 1 } }
  if n > 5 { if source_byte(source, s + 5) != c5 { return 1 != 1 } }
  if n > 6 { if source_byte(source, s + 6) != c6 { return 1 != 1 } }
  if n > 7 { if source_byte(source, s + 7) != c7 { return 1 != 1 } }
  1 == 1
}

thought is_zh_kw(source, token, c0, c1, c2) {
  is_kw(source, token, 3, c0, c1, c2, 0, 0, 0, 0, 0)
}

thought append_source(output, source, start, length) {
  index = start
  end = start + length
  while index < end {
    string_append(output, source_byte(source, index))
    index = index + 1
  }
  output
}

thought join_module_prefix(prefix, alias) {
  output = string_new()
  append_source(output, prefix, 0, source_len(prefix))
  append_source(output, alias, 0, source_len(alias))
  string_append(output, 95)
  string_finish(output)
}

thought decode_string_token(source, token) {
  output = string_new()
  pos = token_start(token) + 1
  end = pos + token_length(token) - 2
  while pos < end {
    byte = source_byte(source, pos)
    if byte == 92 and pos + 1 < end {
      pos = pos + 1
      escaped = source_byte(source, pos)
      byte = escaped
      if escaped == 110 { byte = 10 }
      if escaped == 116 { byte = 9 }
      if escaped == 114 { byte = 13 }
    }
    string_append(output, byte)
    pos = pos + 1
  }
  string_finish(output)
}

thought default_module_alias(path) {
  size = source_len(path)
  start = 0
  index = 0
  while index < size {
    byte = source_byte(path, index)
    if byte == 47 or byte == 92 or byte == 58 { start = index + 1 }
    index = index + 1
  }
  source_slice(path, start, size - start)
}

thought is_runtime_module_path(path) {
  source_len(path) >= 3 and source_byte(path, 0) == 107 and source_byte(path, 1) == 117 and source_byte(path, 2) == 58
}

thought parse_version_part(path, start, end, offset) {
  if start >= end { fail_at("runtime module import must be ku:IDENTITY@MAJOR.MINOR.PATCH", offset) }
  value = 0
  index = start
  while index < end {
    digit = source_byte(path, index) - 48
    if digit < 0 or digit > 9 or value > 429496729 or (value == 429496729 and digit > 5) {
      fail_at("runtime module import must be ku:IDENTITY@MAJOR.MINOR.PATCH", offset)
    }
    value = value * 10 + digit
    index = index + 1
  }
  value
}

thought parse_runtime_module_path(path, offset) {
  size = source_len(path)
  at = -1
  index = 0
  while index < size {
    if source_byte(path, index) == 64 { at = index }
    index = index + 1
  }
  first_dot = -1
  second_dot = -1
  if at >= 0 {
    index = at + 1
    while index < size {
      if source_byte(path, index) == 46 {
        if first_dot < 0 { first_dot = index }
        else if second_dot < 0 { second_dot = index }
        else { fail_at("runtime module import must be ku:IDENTITY@MAJOR.MINOR.PATCH", offset) }
      }
      index = index + 1
    }
  }
  if at <= 3 or first_dot < 0 or second_dot < 0 {
    fail_at("runtime module import must be ku:IDENTITY@MAJOR.MINOR.PATCH", offset)
  }
  identity = source_slice(path, 0, at)
  major = parse_version_part(path, at + 1, first_dot, offset)
  minor = parse_version_part(path, first_dot + 1, second_dot, offset)
  patch = parse_version_part(path, second_dot + 1, size, offset)
  [identity, major, minor, patch]
}

thought is_module_import_decl(source, tokens, token_index) {
  token = tokens[token_index]
  token_type(token) == 3 and ((is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) and token_type(tokens[token_index + 1]) == 2) or is_zh_kw(source, token, 229, 188, 149))
}

thought parse_module_import_decl(source, tokens, token_index) {
  keyword = tokens[token_index]
  path_token = tokens[token_index + 1]
  if token_type(path_token) != 2 { fail_token("expected module import path", tokens, token_index + 1) }
  path = decode_string_token(source, path_token)
  if source_len(path) == 0 { fail_token("module import path must not be empty", tokens, token_index + 1) }
  runtime = is_runtime_module_path(path)
  identity = ""
  major = 0
  minor = 0
  patch = 0
  if runtime {
    runtime_path = parse_runtime_module_path(path, token_start(path_token))
    identity = runtime_path[0]
    major = runtime_path[1]
    minor = runtime_path[2]
    patch = runtime_path[3]
  }
  token_index = token_index + 2
  alias_source = path
  if runtime { alias_source = identity }
  alias = default_module_alias(alias_source)
  if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 2, 97, 115, 0, 0, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 229, 136, 171)) {
    token_index = token_index + 1
    alias_token = tokens[token_index]
    if token_type(alias_token) != 3 { fail_token("expected module import alias", tokens, token_index) }
    alias = source_slice(source, token_start(alias_token), token_length(alias_token))
    token_index = token_index + 1
  }
  if source_len(alias) == 0 { fail_token("module import alias must not be empty", tokens, token_index) }
  if token_type(tokens[token_index]) != 11 and token_type(tokens[token_index]) != 26 { fail_token("unexpected token after module import", tokens, token_index) }
  [token_index, path, alias, runtime, identity, major, minor, patch]
}

thought string_in(values, value) {
  for item in values {
    if item == value { return 1 == 1 }
  }
  1 != 1
}

thought identifier_has_specific_alias(source, token, alias) {
  alias_size = source_len(alias)
  if token_length(token) <= alias_size or source_byte(source, token_start(token) + alias_size) != 95 { return 1 != 1 }
  index = 0
  while index < alias_size {
    if source_byte(source, token_start(token) + index) != source_byte(alias, index) { return 1 != 1 }
    index = index + 1
  }
  1 == 1
}

thought identifier_has_alias(source, token, aliases) {
  for alias in aliases {
    if identifier_has_specific_alias(source, token, alias) { return 1 == 1 }
  }
  1 != 1
}

thought expand_module(source, prefix, active_paths) {
  size = source_len(source)
  tokens = tokenize(source, size)
  module_paths = []
  module_aliases = []
  module_offsets = []
  module_starts = []
  module_runtime = []
  declaration_starts = []
  declaration_ends = []
  declaration_types = []
  declaration_names = []
  local_functions = []
  token_index = 0
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    start_index = token_index
    keyword = tokens[token_index]
    is_import = token_type(keyword) == 3 and is_kw(source, keyword, 6, 105, 109, 112, 111, 114, 116, 0, 0)
    is_module_import = is_module_import_decl(source, tokens, token_index)
    if is_module_import {
      module = parse_module_import_decl(source, tokens, token_index)
      token_index = module[0]
      module_paths = module_paths + [module[1]]
      module_aliases = module_aliases + [module[2]]
      module_offsets = module_offsets + [token_start(keyword)]
      module_starts = module_starts + [start_index]
      module_runtime = module_runtime + [module[3]]
      continue
    }
    if is_import {
      while token_type(tokens[token_index]) != 5 {
        if token_type(tokens[token_index]) == 26 { fail_token("unterminated import", tokens, token_index) }
        token_index = token_index + 1
      }
      token_index = token_index + 1
      declaration_starts = declaration_starts + [start_index]
      declaration_ends = declaration_ends + [token_index]
      declaration_types = declaration_types + [1]
      declaration_names = declaration_names + [0]
      continue
    }
    is_function = token_type(keyword) == 3 and (is_kw(source, keyword, 7, 116, 104, 111, 117, 103, 104, 116, 0) or is_zh_kw(source, keyword, 230, 128, 157))
    if not is_function { fail_at("expected declaration", token_start(keyword)) }
    name_index = token_index + 1
    name_token = tokens[name_index]
    if token_type(name_token) != 3 { fail_token("expected function name", tokens, name_index) }
    local_functions = local_functions + [source_slice(source, token_start(name_token), token_length(name_token))]
    token_index = token_index + 2
    while token_type(tokens[token_index]) != 6 {
      if token_type(tokens[token_index]) == 26 { fail_token("expected function body", tokens, token_index) }
      token_index = token_index + 1
    }
    depth = 0
    while token_type(tokens[token_index]) != 26 {
      if token_type(tokens[token_index]) == 6 { depth = depth + 1 }
      if token_type(tokens[token_index]) == 7 {
        depth = depth - 1
        if depth == 0 { token_index = token_index + 1 break }
      }
      token_index = token_index + 1
    }
    if depth != 0 { fail_token("unterminated function body", tokens, token_index) }
    declaration_starts = declaration_starts + [start_index]
    declaration_ends = declaration_ends + [token_index]
    declaration_types = declaration_types + [2]
    declaration_names = declaration_names + [name_index]
  }

  if len(module_paths) == 0 and source_len(prefix) == 0 { return source }

  output = string_new()
  import_index = 0
  while import_index < len(module_paths) {
    path = module_paths[import_index]
    if module_runtime[import_index] {
      start_index = module_starts[import_index]
      keyword = tokens[start_index]
      path_token = tokens[start_index + 1]
      append_source(output, source, token_start(keyword), token_start(path_token) + token_length(path_token) - token_start(keyword))
      string_append(output, 32)
      string_append(output, 97)
      string_append(output, 115)
      string_append(output, 32)
      append_source(output, prefix, 0, source_len(prefix))
      append_source(output, module_aliases[import_index], 0, source_len(module_aliases[import_index]))
    } else {
      if string_in(active_paths, path) { fail_at("cyclic module import", module_offsets[import_index]) }
      imported = module_source(path)
      expanded = expand_module(imported, join_module_prefix(prefix, module_aliases[import_index]), active_paths + [path])
      append_source(output, expanded, 0, source_len(expanded))
    }
    string_append(output, 10)
    import_index = import_index + 1
  }

  declaration_index = 0
  while declaration_index < len(declaration_starts) {
    start_index = declaration_starts[declaration_index]
    end_index = declaration_ends[declaration_index]
    start_byte = token_start(tokens[start_index])
    last_token = tokens[end_index - 1]
    end_byte = token_start(last_token) + token_length(last_token)
    if declaration_types[declaration_index] == 1 {
      append_source(output, source, start_byte, end_byte - start_byte)
      string_append(output, 10)
      declaration_index = declaration_index + 1
      continue
    }

    bound_names = []
    scan_index = start_index + 3
    while token_type(tokens[scan_index]) != 5 {
      if token_type(tokens[scan_index]) == 3 {
        bound_names = bound_names + [source_slice(source, token_start(tokens[scan_index]), token_length(tokens[scan_index]))]
      }
      scan_index = scan_index + 1
    }
    scan_index = scan_index + 1
    while scan_index < end_index {
      scan_token = tokens[scan_index]
      if token_type(scan_token) == 3 and token_type(tokens[scan_index + 1]) == 18 {
        bound_names = bound_names + [source_slice(source, token_start(scan_token), token_length(scan_token))]
      }
      if token_type(scan_token) == 3 and (is_kw(source, scan_token, 3, 102, 111, 114, 0, 0, 0, 0, 0) or is_kw(source, scan_token, 5, 99, 97, 116, 99, 104, 0, 0, 0) or is_zh_kw(source, scan_token, 233, 129, 141) or is_zh_kw(source, scan_token, 230, 141, 149)) {
        bound_token = tokens[scan_index + 1]
        if token_type(bound_token) == 3 { bound_names = bound_names + [source_slice(source, token_start(bound_token), token_length(bound_token))] }
      }
      scan_index = scan_index + 1
    }

    cursor = start_byte
    rewrite_index = start_index
    while rewrite_index < end_index {
      rewrite_token = tokens[rewrite_index]
      rewrite = rewrite_index == declaration_names[declaration_index]
      if token_type(rewrite_token) == 3 and not rewrite {
        identifier = source_slice(source, token_start(rewrite_token), token_length(rewrite_token))
        if not string_in(bound_names, identifier) and (string_in(local_functions, identifier) or identifier_has_alias(source, rewrite_token, module_aliases)) { rewrite = 1 == 1 }
      }
      if rewrite {
        append_source(output, source, cursor, token_start(rewrite_token) - cursor)
        append_source(output, prefix, 0, source_len(prefix))
        append_source(output, source, token_start(rewrite_token), token_length(rewrite_token))
        cursor = token_start(rewrite_token) + token_length(rewrite_token)
      }
      rewrite_index = rewrite_index + 1
    }
    append_source(output, source, cursor, end_byte - cursor)
    string_append(output, 10)
    declaration_index = declaration_index + 1
  }
  string_finish(output)
}

thought has_module_import(source, tokens) {
  token_index = 0
  while token_type(tokens[token_index]) != 26 {
    token = tokens[token_index]
    if token_type(token) == 3 and ((is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) and token_type(tokens[token_index + 1]) == 2) or is_zh_kw(source, token, 229, 188, 149)) { return 1 == 1 }
    token_index = token_index + 1
  }
  1 != 1
}

thought validate_declarations(source, tokens) {
  token_index = 0
  symbols = []
  runtime_aliases = []
  runtime_identities = []
  runtime_versions = []
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    keyword = tokens[token_index]
    if is_module_import_decl(source, tokens, token_index) {
      module = parse_module_import_decl(source, tokens, token_index)
      if not module[3] { fail_at("runtime module import must be ku:IDENTITY@MAJOR.MINOR.PATCH", token_start(keyword)) }
      existing = 0
      index = 0
      while index < len(runtime_aliases) {
        if runtime_aliases[index] == module[2] { existing = index + 1 }
        index = index + 1
      }
      if existing > 0 {
        index = existing - 1
        version = runtime_versions[index]
        if runtime_identities[index] != module[4] or version[0] != module[5] or version[1] != module[6] or version[2] != module[7] {
          fail_at("runtime module alias has conflicting identities or versions", token_start(keyword))
        }
      } else {
        runtime_aliases = runtime_aliases + [module[2]]
        runtime_identities = runtime_identities + [module[4]]
        runtime_versions = runtime_versions + [[module[5], module[6], module[7]]]
      }
      token_index = module[0]
      continue
    }
    is_import_decl = is_kw(source, keyword, 6, 105, 109, 112, 111, 114, 116, 0, 0)
    is_function_decl = is_kw(source, keyword, 7, 116, 104, 111, 117, 103, 104, 116, 0) or is_zh_kw(source, keyword, 230, 128, 157)
    if not is_import_decl and not is_function_decl { fail_at("expected declaration", token_start(keyword)) }
    name_token = tokens[token_index + 1]
    if token_type(name_token) != 3 { fail_token("expected declaration name", tokens, token_index + 1) }
    name_hash = source_hash(source, token_start(name_token), token_length(name_token))
    if lookup_slot(symbols, name_hash) != 0 { fail_token("duplicate declaration", tokens, token_index + 1) }
    symbols = symbols + [name_hash]
    if is_import_decl {
      while token_type(tokens[token_index]) != 5 {
        if token_type(tokens[token_index]) == 26 { fail_token("unterminated import", tokens, token_index) }
        token_index = token_index + 1
      }
      token_index = token_index + 1
      continue
    }
    token_index = token_index + 2
    if token_type(tokens[token_index]) != 4 { fail_token("expected parameter list", tokens, token_index) }
    token_index = token_index + 1
    parameters = []
    while token_type(tokens[token_index]) != 5 {
      parameter = tokens[token_index]
      if token_type(parameter) != 3 { fail_token("expected parameter name", tokens, token_index) }
      parameter_hash = source_hash(source, token_start(parameter), token_length(parameter))
      if lookup_slot(parameters, parameter_hash) != 0 { fail_token("duplicate parameter", tokens, token_index) }
      parameters = parameters + [parameter_hash]
      token_index = token_index + 1
      if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 continue }
      if token_type(tokens[token_index]) != 5 { fail_token("expected comma or )", tokens, token_index) }
    }
    token_index = token_index + 1
    while token_type(tokens[token_index]) != 6 {
      if token_type(tokens[token_index]) == 26 { fail_token("expected function body", tokens, token_index) }
      token_index = token_index + 1
    }
    depth = 0
    while token_type(tokens[token_index]) != 26 {
      if token_type(tokens[token_index]) == 6 { depth = depth + 1 }
      if token_type(tokens[token_index]) == 7 {
        depth = depth - 1
        if depth == 0 { token_index = token_index + 1 break }
      }
      token_index = token_index + 1
    }
    if depth != 0 { fail_token("unterminated function body", tokens, token_index) }
  }
  0
}

thought parse_number(source, tokens, token_index, handle, next_reg) {
  token = tokens[token_index]
  start = token_start(token)
  length = token_length(token)
  value = 0
  pos = start
  while pos < start + length {
    value = value * 10 + source_byte(source, pos) - 48
    pos = pos + 1
  }
  result_reg = next_reg
  builder_emit(handle, 1, result_reg, 0, 0, value)
  pack(token_index + 1, next_reg + 1, result_reg)
}

thought parse_string(source, tokens, token_index, handle, next_reg) {
  token = tokens[token_index]
  start = token_start(token) + 1
  length = token_length(token) - 2
  text = string_new()
  pos = start
  while pos < start + length {
    byte = source_byte(source, pos)
    if byte == 92 and pos + 1 < start + length {
      pos = pos + 1
      escaped = source_byte(source, pos)
      byte = escaped
      if escaped == 110 { byte = 10 }
      if escaped == 116 { byte = 9 }
      if escaped == 114 { byte = 13 }
      if escaped == 48 { byte = 0 }
    }
    string_append(text, byte)
    pos = pos + 1
  }
  value = string_finish(text)
  data_index = builder_add_string(handle, value)
  result_reg = next_reg
  builder_emit(handle, 25, result_reg, 0, 0, data_index)
  pack(token_index + 1, next_reg + 1, result_reg)
}

thought parse_list(source, tokens, token_index, handle, next_reg, names, regs, size) {
  token_index = token_index + 1
  values = []
  while token_type(tokens[token_index]) != 9 {
    if token_type(tokens[token_index]) == 26 { fail_token("unterminated list literal", tokens, token_index) }
    parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
    value_reg = packed_result(parsed)
    next_reg = packed_next(parsed)
    values = values + [value_reg]
    token_index = packed_index(parsed)
    if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 continue }
    break
  }
  if token_type(tokens[token_index]) != 9 { fail_token("expected ] in list literal", tokens, token_index) }
  token_index = token_index + 1
  base_reg = next_reg
  count = 0
  while count < len(values) {
    builder_emit(handle, 2, next_reg, values[count], 0, 0)
    next_reg = next_reg + 1
    count = count + 1
  }
  result_reg = next_reg
  builder_emit(handle, 26, result_reg, base_reg, count, 0)
  pack(token_index, next_reg + 1, result_reg)
}

thought parse_map(source, tokens, token_index, handle, next_reg, names, regs, size) {
  token_index = token_index + 1
  values = []
  while token_type(tokens[token_index]) != 7 {
    if token_type(tokens[token_index]) == 26 { fail_token("unterminated map literal", tokens, token_index) }
    parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
    key_reg = packed_result(parsed)
    next_reg = packed_next(parsed)
    values = values + [key_reg]
    token_index = packed_index(parsed)
    if token_type(tokens[token_index]) != 12 { fail_token("expected : in map literal", tokens, token_index) }
    token_index = token_index + 1
    parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
    value_reg = packed_result(parsed)
    next_reg = packed_next(parsed)
    values = values + [value_reg]
    token_index = packed_index(parsed)
    if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 continue }
    break
  }
  if token_type(tokens[token_index]) != 7 { fail_token("expected } in map literal", tokens, token_index) }
  token_index = token_index + 1
  base_reg = next_reg
  count = 0
  while count < len(values) {
    builder_emit(handle, 2, next_reg, values[count], 0, 0)
    next_reg = next_reg + 1
    count = count + 1
  }
  result_reg = next_reg
  builder_emit(handle, 29, result_reg, base_reg, count / 2, 0)
  pack(token_index, next_reg + 1, result_reg)
}

thought lookup_slot(names, name_hash) {
  i = len(names) - 1
  while i >= 0 {
    if names[i] == name_hash { return i + 1 }
    i = i - 1
  }
  0
}

thought function_info(source, tokens, target_hash) {
  token_index = 0
  ordinal = 0
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    token = tokens[token_index]
    if is_module_import_decl(source, tokens, token_index) {
      module = parse_module_import_decl(source, tokens, token_index)
      token_index = module[0]
      continue
    }
    if is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) {
      while token_type(tokens[token_index]) != 5 { token_index = token_index + 1 }
      token_index = token_index + 1
      continue
    }
    if not (is_kw(source, token, 7, 116, 104, 111, 117, 103, 104, 116, 0) or is_zh_kw(source, token, 230, 128, 157)) { return 0 }
    name_token = tokens[token_index + 1]
    matches = source_hash(source, token_start(name_token), token_length(name_token)) == target_hash
    token_index = token_index + 3
    arity = 0
    while token_type(tokens[token_index]) != 5 {
      if token_type(tokens[token_index]) == 3 { arity = arity + 1 }
      token_index = token_index + 1
    }
    if matches { return arity * 1000000 + ordinal + 1 }
    ordinal = ordinal + 1
    token_index = token_index + 1
    while token_type(tokens[token_index]) != 6 { token_index = token_index + 1 }
    depth = 0
    while token_type(tokens[token_index]) != 26 {
      if token_type(tokens[token_index]) == 6 { depth = depth + 1 }
      if token_type(tokens[token_index]) == 7 {
        depth = depth - 1
        if depth == 0 { token_index = token_index + 1 break }
      }
      token_index = token_index + 1
    }
  }
  0
}

thought import_info(source, tokens, target_hash) {
  token_index = 0
  ordinal = 0
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    token = tokens[token_index]
    if is_module_import_decl(source, tokens, token_index) {
      module = parse_module_import_decl(source, tokens, token_index)
      token_index = module[0]
      continue
    }
    if not is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) { return 0 }
    name_token = tokens[token_index + 1]
    if source_hash(source, token_start(name_token), token_length(name_token)) == target_hash {
      arity_token = tokens[token_index + 3]
      if token_type(arity_token) != 1 { fail_token("expected import arity", tokens, token_index + 3) }
      return token_integer(source, arity_token) * 1000000 + ordinal + 1
    }
    ordinal = ordinal + 1
    while token_type(tokens[token_index]) != 5 { token_index = token_index + 1 }
    token_index = token_index + 1
  }
  0
}

thought runtime_import_info(source, tokens, name_token) {
  token_index = 0
  best_alias_size = 0
  result = []
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    token = tokens[token_index]
    if is_module_import_decl(source, tokens, token_index) {
      module = parse_module_import_decl(source, tokens, token_index)
      alias_size = source_len(module[2])
      if module[3] and alias_size > best_alias_size and identifier_has_specific_alias(source, name_token, module[2]) {
        export_start = token_start(name_token) + alias_size + 1
        export_size = token_length(name_token) - alias_size - 1
        result = [module[4], module[5], module[6], module[7], source_hash(source, export_start, export_size)]
        best_alias_size = alias_size
      }
      token_index = module[0]
      continue
    }
    if is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) {
      while token_type(tokens[token_index]) != 5 {
        if token_type(tokens[token_index]) == 26 { return [] }
        token_index = token_index + 1
      }
      token_index = token_index + 1
      continue
    }
    if not (is_kw(source, token, 7, 116, 104, 111, 117, 103, 104, 116, 0) or is_zh_kw(source, token, 230, 128, 157)) { return [] }
    token_index = token_index + 2
    while token_type(tokens[token_index]) != 6 {
      if token_type(tokens[token_index]) == 26 { return [] }
      token_index = token_index + 1
    }
    depth = 0
    while token_type(tokens[token_index]) != 26 {
      if token_type(tokens[token_index]) == 6 { depth = depth + 1 }
      if token_type(tokens[token_index]) == 7 {
        depth = depth - 1
        if depth == 0 { token_index = token_index + 1 break }
      }
      token_index = token_index + 1
    }
  }
  result
}

thought info_arity(info) { info / 1000000 }
thought info_index(info) { info % 1000000 - 1 }

thought parse_primary(source, tokens, token_index, handle, next_reg, names, regs, size) {
  token = tokens[token_index]
  type = token_type(token)
  if type == 1 { return parse_number(source, tokens, token_index, handle, next_reg) }
  if type == 2 { return parse_string(source, tokens, token_index, handle, next_reg) }
  if type == 8 { return parse_list(source, tokens, token_index, handle, next_reg, names, regs, size) }
  if type == 6 { return parse_map(source, tokens, token_index, handle, next_reg, names, regs, size) }
  if type == 25 {
    parsed = parse_primary(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    result_reg = next_reg
    builder_emit(handle, 7, result_reg, packed_result(parsed), 0, 0)
    return pack(token_index, next_reg + 1, result_reg)
  }
  if type == 14 {
    if token_type(tokens[token_index + 1]) == 1 {
      number_token = tokens[token_index + 1]
      value = 0
      pos = token_start(number_token)
      end = pos + token_length(number_token)
      while pos < end {
        value = value * 10 + source_byte(source, pos) - 48
        pos = pos + 1
      }
      result_reg = next_reg
      builder_emit(handle, 1, result_reg, 0, 0, 0 - value)
      return pack(token_index + 2, next_reg + 1, result_reg)
    }
    parsed = parse_primary(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    result_reg = next_reg
    next_reg = next_reg + 1
    zero_reg = next_reg
    builder_emit(handle, 1, zero_reg, 0, 0, 0)
    next_reg = next_reg + 1
    builder_emit(handle, 4, result_reg, zero_reg, value_reg, 0)
    return pack(token_index, next_reg, result_reg)
  }
  if type == 4 {
    parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    if token_type(tokens[token_index]) != 5 { fail_token("expected ) after expression", tokens, token_index) }
    token_index = token_index + 1
    return pack(token_index, packed_next(parsed), packed_result(parsed))
  }
  if type == 3 {
    if is_kw(source, token, 3, 110, 111, 116, 0, 0, 0, 0, 0) {
      parsed = parse_primary(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
      token_index = packed_index(parsed)
      next_reg = packed_next(parsed)
      result_reg = next_reg
      builder_emit(handle, 7, result_reg, packed_result(parsed), 0, 0)
      return pack(token_index, next_reg + 1, result_reg)
    }
    if is_kw(source, token, 4, 116, 114, 117, 101, 0, 0, 0, 0) or is_zh_kw(source, token, 231, 156, 159) {
      result_reg = next_reg
      builder_emit(handle, 17, result_reg, 0, 0, 1)
      return pack(token_index + 1, next_reg + 1, result_reg)
    }
    if is_kw(source, token, 5, 102, 97, 108, 115, 101, 0, 0, 0) or is_zh_kw(source, token, 229, 129, 135) {
      result_reg = next_reg
      builder_emit(handle, 17, result_reg, 0, 0, -1)
      return pack(token_index + 1, next_reg + 1, result_reg)
    }
    if is_kw(source, token, 4, 110, 117, 108, 108, 0, 0, 0, 0) or is_zh_kw(source, token, 231, 169, 186) {
      result_reg = next_reg
      builder_emit(handle, 35, result_reg, 0, 0, 0)
      return pack(token_index + 1, next_reg + 1, result_reg)
    }
    name_hash = source_hash(source, token_start(token), token_length(token))
    token_index = token_index + 1
    if token_type(tokens[token_index]) == 4 {
      if token_length(token) == 3 and source_byte(source, token_start(token)) == 108 and source_byte(source, token_start(token) + 1) == 101 and source_byte(source, token_start(token) + 2) == 110 {
        parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
        value_reg = packed_result(parsed)
        next_reg = packed_next(parsed)
        token_index = packed_index(parsed)
        if token_type(tokens[token_index]) != 5 { fail_token("expected ) after len argument", tokens, token_index) }
        token_index = token_index + 1
        result_reg = next_reg
        builder_emit(handle, 27, result_reg, value_reg, 0, 0)
        return pack(token_index, next_reg + 1, result_reg)
      }
      if is_kw(source, token, 4, 98, 105, 110, 100, 0, 0, 0, 0) {
        token_index = token_index + 1
        target_token = tokens[token_index]
        if token_type(target_token) != 3 { fail_at("bind expects a named function", token_start(target_token)) }
        target_hash = source_hash(source, token_start(target_token), token_length(target_token))
        target_info = function_info(source, tokens, target_hash)
        if target_info == 0 { fail_at("bind target is not a local function", token_start(target_token)) }
        token_index = token_index + 1
        captures = []
        if token_type(tokens[token_index]) != 5 {
          if token_type(tokens[token_index]) != 10 { fail_token("expected comma after bind target", tokens, token_index) }
          token_index = token_index + 1
          if token_type(tokens[token_index]) == 5 { fail_token("expected bind capture", tokens, token_index) }
          while token_type(tokens[token_index]) != 5 {
            parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
            captures = captures + [packed_result(parsed)]
            next_reg = packed_next(parsed)
            token_index = packed_index(parsed)
            if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 continue }
            break
          }
        }
        if token_type(tokens[token_index]) != 5 { fail_token("expected ) after bind captures", tokens, token_index) }
        token_index = token_index + 1
        capture_reg = 0
        if len(captures) > 0 { capture_reg = next_reg }
        capture_index = 0
        while capture_index < len(captures) {
          builder_emit(handle, 2, next_reg, captures[capture_index], 0, 0)
          next_reg = next_reg + 1
          capture_index = capture_index + 1
        }
        result_reg = next_reg
        builder_emit(handle, 40, result_reg, capture_reg, len(captures), info_index(target_info))
        return pack(token_index, next_reg + 1, result_reg)
      }
      token_index = token_index + 1
      arguments = []
      while token_type(tokens[token_index]) != 5 {
        if token_type(tokens[token_index]) == 26 { fail_token("unterminated argument list", tokens, token_index) }
        parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
        argument_reg = packed_result(parsed)
        next_reg = packed_next(parsed)
        arguments = arguments + [argument_reg]
        token_index = packed_index(parsed)
        if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 continue }
        break
      }
      if token_type(tokens[token_index]) != 5 { fail_token("expected ) in call", tokens, token_index) }
      token_index = token_index + 1
      if is_kw(source, token, 4, 112, 117, 115, 104, 0, 0, 0, 0) {
        if len(arguments) != 2 { fail_at("push argument count mismatch", token_start(token)) }
        builder_emit(handle, 37, arguments[0], arguments[1], 0, 0)
        return pack(token_index, next_reg, arguments[0])
      }
      argument_reg = 0
      if len(arguments) > 0 { argument_reg = next_reg }
      argument_count = 0
      while argument_count < len(arguments) {
        builder_emit(handle, 2, next_reg, arguments[argument_count], 0, 0)
        next_reg = next_reg + 1
        argument_count = argument_count + 1
      }
      result_reg = next_reg
      value_slot = lookup_slot(names, name_hash)
      if value_slot > 0 {
        builder_emit(handle, 39, result_reg, regs[value_slot - 1], argument_reg, argument_count)
      } else {
        call_info = import_info(source, tokens, name_hash)
        if call_info > 0 {
        if info_arity(call_info) != argument_count { fail_at("host argument count mismatch", token_start(token)) }
        builder_emit(handle, 16, result_reg, argument_reg, argument_count, info_index(call_info))
        } else {
          call_info = function_info(source, tokens, name_hash)
          if call_info > 0 {
            if info_arity(call_info) != argument_count { fail_at("function argument count mismatch", token_start(token)) }
            builder_emit(handle, 14, result_reg, argument_reg, argument_count, info_index(call_info))
          } else {
            runtime_info = runtime_import_info(source, tokens, token)
            if len(runtime_info) == 0 { fail_at("unknown function", token_start(token)) }
            module_import_index = builder_module_import(handle, runtime_info[0], runtime_info[1], runtime_info[2], runtime_info[3], runtime_info[4], argument_count)
            builder_emit(handle, 41, result_reg, argument_reg, argument_count, module_import_index)
          }
        }
      }
      return pack(token_index, next_reg + 1, result_reg)
    }
    value_slot = lookup_slot(names, name_hash)
    if value_slot > 0 {
      result_reg = regs[value_slot - 1]
    } else {
      call_info = function_info(source, tokens, name_hash)
      if call_info == 0 { fail_at("undefined identifier", token_start(token)) }
      result_reg = next_reg
      builder_emit(handle, 38, result_reg, 0, 0, info_index(call_info))
      next_reg = next_reg + 1
    }
    while token_type(tokens[token_index]) == 8 {
      parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
      token_index = packed_index(parsed)
      next_reg = packed_next(parsed)
      index_reg = packed_result(parsed)
      if token_type(tokens[token_index]) != 9 { fail_token("expected ] in index", tokens, token_index) }
      token_index = token_index + 1
      value_reg = next_reg
      builder_emit(handle, 30, value_reg, result_reg, index_reg, 0)
      next_reg = next_reg + 1
      result_reg = value_reg
    }
    return pack(token_index, next_reg, result_reg)
  }
  fail_at("expected expression", token_start(token))
}

thought parse_multiplicative(source, tokens, token_index, handle, next_reg, names, regs, size) {
  parsed = parse_primary(source, tokens, token_index, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while token_type(tokens[token_index]) == 15 or token_type(tokens[token_index]) == 16 or token_type(tokens[token_index]) == 17 {
    opcode = 5
    if token_type(tokens[token_index]) == 16 { opcode = 6 }
    if token_type(tokens[token_index]) == 17 { opcode = 18 }
    parsed = parse_primary(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(token_index, next_reg, result_reg)
}

thought parse_additive(source, tokens, token_index, handle, next_reg, names, regs, size) {
  parsed = parse_multiplicative(source, tokens, token_index, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while token_type(tokens[token_index]) == 13 or token_type(tokens[token_index]) == 14 {
    opcode = 3
    if token_type(tokens[token_index]) == 14 { opcode = 4 }
    if opcode == 3 and token_type(tokens[token_index + 1]) == 8 {
      parsed = parse_expression(source, tokens, token_index + 2, handle, next_reg, names, regs, size)
      token_index = packed_index(parsed)
      next_reg = packed_next(parsed)
      if token_type(tokens[token_index]) == 9 {
        builder_emit(handle, 37, result_reg, packed_result(parsed), 0, 0)
        token_index = token_index + 1
        continue
      }
      fail_token("list append expects one value", tokens, token_index)
    }
    parsed = parse_multiplicative(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(token_index, next_reg, result_reg)
}

thought parse_comparison(source, tokens, token_index, handle, next_reg, names, regs, size) {
  parsed = parse_additive(source, tokens, token_index, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  type = token_type(tokens[token_index])
  if type < 19 or type > 24 { return pack(token_index, next_reg, result_reg) }
  opcode = type
  parsed = parse_additive(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  value_reg = packed_result(parsed)
  combined_reg = next_reg
  builder_emit(handle, opcode, combined_reg, result_reg, value_reg, 0)
  pack(token_index, next_reg + 1, combined_reg)
}

thought parse_and(source, tokens, token_index, handle, next_reg, names, regs, size) {
  parsed = parse_comparison(source, tokens, token_index, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while token_type(tokens[token_index]) == 3 and is_kw(source, tokens[token_index], 3, 97, 110, 100, 0, 0, 0, 0, 0) {
    parsed = parse_comparison(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, 8, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(token_index, next_reg, result_reg)
}

thought parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size) {
  parsed = parse_and(source, tokens, token_index, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  result_reg = packed_result(parsed)
  while token_type(tokens[token_index]) == 3 and is_kw(source, tokens[token_index], 2, 111, 114, 0, 0, 0, 0, 0, 0) {
    parsed = parse_and(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    value_reg = packed_result(parsed)
    combined_reg = next_reg
    builder_emit(handle, 9, combined_reg, result_reg, value_reg, 0)
    next_reg = next_reg + 1
    result_reg = combined_reg
  }
  pack(token_index, next_reg, result_reg)
}

thought skip_lines(tokens, token_index) {
  while token_type(tokens[token_index]) == 11 { token_index = token_index + 1 }
  token_index
}

thought block_end(tokens, token_index) {
  depth = 0
  while token_type(tokens[token_index]) != 26 {
    type = token_type(tokens[token_index])
    if type == 6 { depth = depth + 1 }
    if type == 7 {
      depth = depth - 1
      if depth == 0 { return token_index + 1 }
    }
    token_index = token_index + 1
  }
  token_index
}

thought if_tail_end(source, tokens, body_index) {
  token_index = skip_lines(tokens, block_end(tokens, body_index))
  if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 4, 101, 108, 115, 101, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 229, 144, 166)) {
    token_index = skip_lines(tokens, token_index + 1)
    if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 2, 105, 102, 0, 0, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 232, 139, 165)) {
      token_index = token_index + 1
      paren_depth = 0
      bracket_depth = 0
      while token_type(tokens[token_index]) != 26 {
        type = token_type(tokens[token_index])
        if type == 4 { paren_depth = paren_depth + 1 }
        if type == 5 { paren_depth = paren_depth - 1 }
        if type == 8 { bracket_depth = bracket_depth + 1 }
        if type == 9 { bracket_depth = bracket_depth - 1 }
        if type == 6 and paren_depth == 0 and bracket_depth == 0 {
          return if_tail_end(source, tokens, token_index)
        }
        token_index = token_index + 1
      }
      return token_index
    }
    if token_type(tokens[token_index]) == 6 {
      return skip_lines(tokens, block_end(tokens, token_index))
    }
  }
  token_index
}

thought parse_if_statement(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, implicit_return) {
  parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  condition_reg = packed_result(parsed)
  if token_type(tokens[token_index]) != 6 { fail_token("expected { after if condition", tokens, token_index) }
  branch_implicit_return = 1 != 1
  if implicit_return and token_type(tokens[if_tail_end(source, tokens, token_index)]) == 7 {
    branch_implicit_return = 1 == 1
  }
  token_index = token_index + 1
  negative_branch = builder_position(handle)
  builder_emit(handle, 10, 0, condition_reg, 0, 0)
  zero_branch = builder_position(handle)
  builder_emit(handle, 11, 0, condition_reg, 0, 0)
  parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, branch_implicit_return)
  token_index = packed_index(parsed)
  next_reg = packed_next(parsed)
  if token_type(tokens[token_index]) != 7 { fail_token("expected } after if body", tokens, token_index) }
  token_index = skip_lines(tokens, token_index + 1)
  if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 4, 101, 108, 115, 101, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 229, 144, 166)) {
    end_branch = builder_position(handle)
    builder_emit(handle, 13, 0, 0, 0, 0)
    alternate_start = builder_position(handle)
    builder_patch(handle, negative_branch, alternate_start)
    builder_patch(handle, zero_branch, alternate_start)
    token_index = skip_lines(tokens, token_index + 1)
    if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 2, 105, 102, 0, 0, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 232, 139, 165)) {
      parsed = parse_if_statement(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, branch_implicit_return)
      token_index = packed_index(parsed)
      next_reg = packed_next(parsed)
    } else {
      if token_type(tokens[token_index]) != 6 { fail_token("expected { after else", tokens, token_index) }
      token_index = token_index + 1
      parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, branch_implicit_return)
      token_index = packed_index(parsed)
      next_reg = packed_next(parsed)
      if token_type(tokens[token_index]) != 7 { fail_token("expected } after else body", tokens, token_index) }
      token_index = skip_lines(tokens, token_index + 1)
    }
    builder_patch(handle, end_branch, builder_position(handle))
    return pack(token_index, next_reg, 0)
  }
  target = builder_position(handle)
  builder_patch(handle, negative_branch, target)
  builder_patch(handle, zero_branch, target)
  pack(token_index, next_reg, 0)
}

thought parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, implicit_return) {
  result_reg = 0
  while token_type(tokens[token_index]) != 7 and token_type(tokens[token_index]) != 26 {
    token = tokens[token_index]
    type = token_type(token)
    if type == 11 { token_index = token_index + 1 continue }
    if type == 3 {
      if is_kw(source, token, 5, 98, 114, 101, 97, 107, 0, 0, 0) or is_zh_kw(source, token, 230, 150, 173) {
        if loop_depth > 0 { builder_emit(handle, 13, 0, 0, 0, -1) }
        token_index = token_index + 1
        if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 }
        continue
      }
      if is_kw(source, token, 8, 99, 111, 110, 116, 105, 110, 117, 101) or is_zh_kw(source, token, 231, 187, 173) {
        if loop_depth > 0 { builder_emit(handle, 13, 0, 0, 0, -2) }
        token_index = token_index + 1
        if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 }
        continue
      }
      if is_kw(source, token, 5, 116, 104, 114, 111, 119, 0, 0, 0) or is_zh_kw(source, token, 230, 138, 155) {
        parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        result_reg = packed_result(parsed)
        builder_emit(handle, 33, 0, result_reg, 0, 0)
        if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
        break
      }
      if is_kw(source, token, 3, 116, 114, 121, 0, 0, 0, 0, 0) or is_zh_kw(source, token, 232, 175, 149) {
        token_index = token_index + 1
        if token_type(tokens[token_index]) != 6 { fail_token("expected { after try", tokens, token_index) }
        token_index = token_index + 1
        try_begin = builder_position(handle)
        builder_emit(handle, 31, 0, 0, 0, 0)
        parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, 1 != 1)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        builder_emit(handle, 32, 0, 0, 0, 0)
        end_branch = builder_position(handle)
        builder_emit(handle, 13, 0, 0, 0, 0)
        if token_type(tokens[token_index]) != 7 { fail_token("expected } after try body", tokens, token_index) }
        token_index = token_index + 1
        if token_type(tokens[token_index]) == 3 and (is_kw(source, tokens[token_index], 5, 99, 97, 116, 99, 104, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 230, 141, 149)) {
          token_index = token_index + 1
          catch_token = tokens[token_index]
          if token_type(catch_token) != 3 { fail_token("expected catch variable", tokens, token_index) }
          catch_hash = source_hash(source, token_start(catch_token), token_length(catch_token))
          token_index = token_index + 1
          slot = lookup_slot(names, catch_hash)
          if slot == 0 {
            catch_reg = next_reg
            names = names + [catch_hash]
            regs = regs + [catch_reg]
            next_reg = next_reg + 1
          } else { catch_reg = regs[slot - 1] }
          if token_type(tokens[token_index]) != 6 { fail_token("expected { after catch variable", tokens, token_index) }
          token_index = token_index + 1
          catch_start = builder_position(handle)
          builder_patch(handle, try_begin, catch_start)
          builder_emit(handle, 34, catch_reg, 0, 0, 0)
          parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, 1 != 1)
          token_index = packed_index(parsed)
          next_reg = packed_next(parsed)
          if token_type(tokens[token_index]) != 7 { fail_token("expected } after catch body", tokens, token_index) }
          token_index = token_index + 1
          target = builder_position(handle)
          builder_patch(handle, end_branch, target)
          continue
        }
        target = builder_position(handle)
        builder_patch(handle, try_begin, target)
        builder_patch(handle, end_branch, target)
        continue
      }
      if is_kw(source, token, 2, 105, 102, 0, 0, 0, 0, 0, 0) or is_zh_kw(source, token, 232, 139, 165) {
        parsed = parse_if_statement(source, tokens, token_index, handle, next_reg, names, regs, loop_depth, size, implicit_return)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        continue
      }
      if is_kw(source, token, 6, 114, 101, 116, 117, 114, 110, 0, 0) or is_zh_kw(source, token, 232, 191, 148) {
        parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        result_reg = packed_result(parsed)
        builder_emit(handle, 15, 0, result_reg, 0, 0)
        if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
        break
      }
      if is_kw(source, token, 3, 102, 111, 114, 0, 0, 0, 0, 0) or is_zh_kw(source, token, 233, 129, 141) {
        token_index = token_index + 1
        item_token = tokens[token_index]
        if token_type(item_token) != 3 { fail_token("expected variable after for", tokens, token_index) }
        item_hash = source_hash(source, token_start(item_token), token_length(item_token))
        token_index = token_index + 1
        if token_type(tokens[token_index]) != 3 or not (is_kw(source, tokens[token_index], 2, 105, 110, 0, 0, 0, 0, 0, 0) or is_zh_kw(source, tokens[token_index], 228, 186, 142)) { fail_token("expected in after for variable", tokens, token_index) }
        token_index = token_index + 1
        parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        list_reg = packed_result(parsed)
        if token_type(tokens[token_index]) != 6 { fail_token("expected { after for iterable", tokens, token_index) }
        token_index = token_index + 1
        length_reg = next_reg
        builder_emit(handle, 27, length_reg, list_reg, 0, 0)
        next_reg = next_reg + 1
        cursor_reg = next_reg
        builder_emit(handle, 1, cursor_reg, 0, 0, 0)
        next_reg = next_reg + 1
        loop_start = builder_position(handle)
        compare_reg = next_reg
        builder_emit(handle, 21, compare_reg, cursor_reg, length_reg, 0)
        next_reg = next_reg + 1
        negative_branch = builder_position(handle)
        builder_emit(handle, 10, 0, compare_reg, 0, 0)
        zero_branch = builder_position(handle)
        builder_emit(handle, 11, 0, compare_reg, 0, 0)
        slot = lookup_slot(names, item_hash)
        if slot == 0 {
          item_reg = next_reg
          names = names + [item_hash]
          regs = regs + [item_reg]
          next_reg = next_reg + 1
        } else { item_reg = regs[slot - 1] }
        builder_emit(handle, 28, item_reg, list_reg, cursor_reg, 0)
        body_start = builder_position(handle)
        parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth + 1, size, 1 != 1)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        increment_start = builder_position(handle)
        one_reg = next_reg
        builder_emit(handle, 1, one_reg, 0, 0, 1)
        next_reg = next_reg + 1
        builder_emit(handle, 3, cursor_reg, cursor_reg, one_reg, 0)
        builder_emit(handle, 13, 0, 0, 0, loop_start)
        target = builder_position(handle)
        builder_patch(handle, negative_branch, target)
        builder_patch(handle, zero_branch, target)
        builder_patch_marked(handle, body_start, increment_start, -1, target)
        builder_patch_marked(handle, body_start, increment_start, -2, increment_start)
        if token_type(tokens[token_index]) != 7 { fail_token("expected } after for body", tokens, token_index) }
        token_index = token_index + 1
        continue
      }
      if is_kw(source, token, 5, 119, 104, 105, 108, 101, 0, 0, 0) or is_zh_kw(source, token, 229, 189, 147) {
        loop_start = builder_position(handle)
        parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        condition_reg = packed_result(parsed)
        if token_type(tokens[token_index]) != 6 { fail_token("expected { after while condition", tokens, token_index) }
        token_index = token_index + 1
        negative_branch = builder_position(handle)
        builder_emit(handle, 10, 0, condition_reg, 0, 0)
        zero_branch = builder_position(handle)
        builder_emit(handle, 11, 0, condition_reg, 0, 0)
        body_start = builder_position(handle)
        parsed = parse_body(source, tokens, token_index, handle, next_reg, names, regs, loop_depth + 1, size, 1 != 1)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        body_end = builder_position(handle)
        builder_emit(handle, 13, 0, 0, 0, loop_start)
        target = builder_position(handle)
        builder_patch(handle, negative_branch, target)
        builder_patch(handle, zero_branch, target)
        builder_patch_marked(handle, body_start, body_end, -1, target)
        builder_patch_marked(handle, body_start, body_end, -2, loop_start)
        if token_type(tokens[token_index]) != 7 { fail_token("expected } after while body", tokens, token_index) }
        token_index = token_index + 1
        continue
      }
      name_hash = source_hash(source, token_start(token), token_length(token))
      if token_type(tokens[token_index + 1]) == 8 {
        scan = token_index + 1
        while token_type(tokens[scan]) == 8 {
          bracket_depth = 1
          scan = scan + 1
          while bracket_depth > 0 {
            if token_type(tokens[scan]) == 26 { fail_token("unterminated index", tokens, scan) }
            if token_type(tokens[scan]) == 8 { bracket_depth = bracket_depth + 1 }
            if token_type(tokens[scan]) == 9 { bracket_depth = bracket_depth - 1 }
            scan = scan + 1
          }
        }
        if token_type(tokens[scan]) == 18 {
          object_slot = lookup_slot(names, name_hash)
          if object_slot == 0 { fail_token("undefined identifier", tokens, token_index) }
          object_reg = regs[object_slot - 1]
          token_index = token_index + 1
          while token_type(tokens[token_index]) == 8 {
            parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
            token_index = packed_index(parsed)
            next_reg = packed_next(parsed)
            key_reg = packed_result(parsed)
            if token_type(tokens[token_index]) != 9 { fail_token("expected ] in index assignment", tokens, token_index) }
            token_index = token_index + 1
            if token_type(tokens[token_index]) == 8 {
              nested_reg = next_reg
              builder_emit(handle, 30, nested_reg, object_reg, key_reg, 0)
              next_reg = next_reg + 1
              object_reg = nested_reg
              continue
            }
            break
          }
          if token_type(tokens[token_index]) != 18 { fail_token("expected = in index assignment", tokens, token_index) }
          parsed = parse_expression(source, tokens, token_index + 1, handle, next_reg, names, regs, size)
          token_index = packed_index(parsed)
          next_reg = packed_next(parsed)
          value_reg = packed_result(parsed)
          builder_emit(handle, 36, object_reg, key_reg, value_reg, 0)
          result_reg = value_reg
          if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 }
          continue
        }
      }
      if token_type(tokens[token_index + 1]) == 18 {
        parsed = parse_expression(source, tokens, token_index + 2, handle, next_reg, names, regs, size)
        token_index = packed_index(parsed)
        next_reg = packed_next(parsed)
        result_reg = packed_result(parsed)
        slot = lookup_slot(names, name_hash)
        if slot == 0 {
          declared_reg = next_reg
          builder_emit(handle, 2, declared_reg, result_reg, 0, 0)
          names = names + [name_hash]
          regs = regs + [declared_reg]
          next_reg = next_reg + 1
          result_reg = declared_reg
        } else {
          result_reg = regs[slot - 1]
          if result_reg != packed_result(parsed) {
            builder_emit(handle, 2, result_reg, packed_result(parsed), 0, 0)
          }
        }
        if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 }
        continue
      }
    }
    parsed = parse_expression(source, tokens, token_index, handle, next_reg, names, regs, size)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    result_reg = packed_result(parsed)
    while token_type(tokens[token_index]) == 11 {
      token_index = token_index + 1
    }
    if implicit_return and token_type(tokens[token_index]) == 7 {
      builder_emit(handle, 15, 0, result_reg, 0, 0)
    }
    continue
  }
  pack(token_index, next_reg, result_reg)
}

thought compile_module(source, identified, identity, major, minor, patch) {
  handle = builder_new()
  if identified { builder_identity(handle, identity, major, minor, patch) }
  size = source_len(source)
  tokens = tokenize(source, size)
  if has_module_import(source, tokens) {
    source = expand_module(source, "", [])
    size = source_len(source)
    tokens = tokenize(source, size)
  }
  validate_declarations(source, tokens)
  token_index = 0
  while token_type(tokens[token_index]) != 26 {
    if token_type(tokens[token_index]) == 11 { token_index = token_index + 1 continue }
    token = tokens[token_index]
    if is_module_import_decl(source, tokens, token_index) {
      module = parse_module_import_decl(source, tokens, token_index)
      token_index = module[0]
      continue
    }
    if token_type(token) == 3 and is_kw(source, token, 6, 105, 109, 112, 111, 114, 116, 0, 0) {
      token_index = token_index + 1
      name_token = tokens[token_index]
      if token_type(name_token) != 3 { fail_token("expected import name", tokens, token_index) }
      import_symbol = source_hash(source, token_start(name_token), token_length(name_token))
      token_index = token_index + 1
      if token_type(tokens[token_index]) != 4 { fail_token("expected ( after import name", tokens, token_index) }
      token_index = token_index + 1
      arity_token = tokens[token_index]
      if token_type(arity_token) != 1 { fail_token("expected import arity", tokens, token_index) }
      arity = token_integer(source, arity_token)
      token_index = token_index + 1
      if token_type(tokens[token_index]) != 5 { fail_token("expected ) after import arity", tokens, token_index) }
      token_index = token_index + 1
      builder_import(handle, import_symbol, arity)
      continue
    }
    if token_type(token) != 3 or not (is_kw(source, token, 7, 116, 104, 111, 117, 103, 104, 116, 0) or is_zh_kw(source, token, 230, 128, 157)) { fail_at("expected thought declaration", token_start(token)) }
    token_index = token_index + 1
    name_token = tokens[token_index]
    if token_type(name_token) != 3 { fail_token("expected function name", tokens, token_index) }
    export_symbol = source_hash(source, token_start(name_token), token_length(name_token))
    token_index = token_index + 1
    if token_type(tokens[token_index]) != 4 { fail_token("expected ( after function name", tokens, token_index) }
    token_index = token_index + 1
    names = []
    regs = []
    param_count = 0
    if token_type(tokens[token_index]) != 5 {
      while token_type(tokens[token_index]) != 5 {
        param_token = tokens[token_index]
        names = names + [source_hash(source, token_start(param_token), token_length(param_token))]
        regs = regs + [param_count]
        param_count = param_count + 1
        token_index = token_index + 1
        if token_type(tokens[token_index]) == 10 { token_index = token_index + 1 }
      }
    }
    token_index = token_index + 1
    if token_type(tokens[token_index]) != 6 { fail_token("expected function body", tokens, token_index) }
    token_index = token_index + 1
    builder_begin(handle, param_count, 4096)
    parsed = parse_body(source, tokens, token_index, handle, param_count, names, regs, 0, size, 1 == 1)
    token_index = packed_index(parsed)
    next_reg = packed_next(parsed)
    builder_emit(handle, 0, 0, 0, 0, 0)
    zero_reg = next_reg
    builder_emit(handle, 1, zero_reg, 0, 0, 0)
    next_reg = next_reg + 1
    builder_emit(handle, 15, 0, zero_reg, 0, 0)
    builder_finish(handle, export_symbol, next_reg)
    if token_type(tokens[token_index]) != 7 { fail_token("unterminated function body", tokens, token_index) }
    token_index = token_index + 1
  }
  builder_encode(handle)
}

thought compile(source) {
  compile_module(source, 1 != 1, "", 0, 0, 0)
}

thought compile_identified(source, name, major, minor, patch) {
  compile_module(source, 1 == 1, name, major, minor, patch)
}
